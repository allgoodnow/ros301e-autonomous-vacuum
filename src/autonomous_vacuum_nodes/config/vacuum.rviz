Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 44; 48; 54
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Path
      Name: Planned path
      Enabled: true
      Value: true
      Color: 0; 120; 230
      Alpha: 1
      Line Style: Billboards
      Line Width: 0.035
      Buffer Length: 1
      Offset: {X: 0, Y: 0, Z: 0.055}
      Topic:
        Value: /vacuum/navigation/path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Floor, robot, dock and coverage
      Enabled: true
      Value: true
      Topic:
        Value: /vacuum/visualization/floor
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top-down floor
      Target Frame: <Fixed Frame>
      Angle: 0
      Scale: 125
      X: 2.5
      Y: 1.75
  Value: true
Window Geometry:
  Width: 1120
  Height: 760
